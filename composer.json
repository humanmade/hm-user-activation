{
    "name": "humanmade/hm-user-activation",
    "description": "User activation flow handler for the frontend, keeping user activation within a site even on a network.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Human Made Limited",
            "email": "engineering@humanmade.com"
        }
    ],
    "require": {
        "composer/installers": "^1 || ^2"
    },
    "suggest": {
        "bjeavons/zxcvbn-php": "Lets the plugin reject weak passwords on the server. Without it, use the hm_user_activation_password_is_weak filter."
    },
    "require-dev": {
        "bjeavons/zxcvbn-php": "^1.4",
        "humanmade/coding-standards": "^2.3",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "lint": "phpcs"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
